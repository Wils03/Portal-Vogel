@* Cliente em foco, no topo de todas as telas *@
@implements IDisposable
@inject ClienteAtualService ClienteAtual
@inject AcessoService Acessos
@inject IDbContextFactory<ApplicationDbContext> Fabrica

@if (acesso.EhVogel)
{
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-building text-muted"></i>
        <select class="form-select form-select-sm seletor-cliente" title="Cliente em foco em todas as telas"
                value="@ClienteAtual.ClienteId" @onchange="Trocar">
            <option value="0">Todos os clientes</option>
            @foreach (var c in clientes) { <option value="@c.Id">@c.Nome</option> }
        </select>
    </div>
}
else if (acesso.EhCliente)
{
    <span class="small"><i class="bi bi-building me-1"></i><strong>@acesso.ClienteNome</strong></span>
}

@code {
    private Acesso acesso = Acesso.Nenhum;
    private List<Cliente> clientes = [];

    protected override async Task OnInitializedAsync()
    {
        acesso = await Acessos.ObterAsync();
        ClienteAtual.Mudou += AoMudar;
        if (acesso.EhVogel)
        {
            await using var db = await Fabrica.CreateDbContextAsync();
            clientes = await db.Clientes.AsNoTracking().Where(c => c.Ativo).OrderBy(c => c.Nome).ToListAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await ClienteAtual.RestaurarAsync();
    }

    private async Task Trocar(ChangeEventArgs e) =>
        await ClienteAtual.DefinirAsync(int.TryParse(e.Value as string, out var id) ? id : 0);

    private Task AoMudar() => InvokeAsync(StateHasChanged);

    public void Dispose() => ClienteAtual.Mudou -= AoMudar;
}
